<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime, no App Sandbox. Login items and Accessibility
	     continue to work without extra TCC entitlements. -->
	<!-- Required so NSAppleScript can read Brave/Chrome/Safari active-tab URLs
	     under the hardened runtime (distraction keywords). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
